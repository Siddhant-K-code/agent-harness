diff --git a/tags.js b/tags.js
index 3f1aa25..89a7c9c 100644
--- a/tags.js
+++ b/tags.js
@@ -1,5 +1,24 @@
 function normalizeTags(tags) {
-  return [...new Set(tags)];
+  const seen = new Set();
+  const normalized = [];
+
+  for (const tag of tags) {
+    const trimmed = tag.trim();
+
+    if (trimmed === '') {
+      continue;
+    }
+
+    const key = trimmed.toLowerCase();
+    if (seen.has(key)) {
+      continue;
+    }
+
+    seen.add(key);
+    normalized.push(trimmed);
+  }
+
+  return normalized;
 }
 
 module.exports = { normalizeTags };
