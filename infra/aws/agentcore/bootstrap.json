{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Agent harness: scoped GitHub OIDC bootstrap for bounded AgentCore experiments. No model access or long-lived access keys.",
  "Parameters": {
    "GitHubSubjectPrefix": {
      "Type": "String",
      "Default": "repo:Siddhant-K-code@55068936/agent-harness@1358016254",
      "AllowedPattern": "repo:[A-Za-z0-9_.-]+@[0-9]+/[A-Za-z0-9_.-]+@[0-9]+",
      "Description": "Exact immutable subject prefix from GitHub OIDC settings, without the branch suffix."
    }
  },
  "Rules": {
    "Region": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "us-east-1"
            ]
          },
          "AssertDescription": "The reviewed experiment is restricted to us-east-1."
        }
      ]
    }
  },
  "Resources": {
    "GitHubOIDC": {
      "Type": "AWS::IAM::OIDCProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ]
      }
    },
    "RuntimeIdentityServiceRole": {
      "Type": "AWS::IAM::ServiceLinkedRole",
      "Properties": {
        "AWSServiceName": "runtime-identity.bedrock-agentcore.amazonaws.com",
        "Description": "AgentCore service-managed identity for agent-harness runtime experiments"
      }
    },
    "ProbeRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "agent-harness-probe",
        "ImageTagMutability": "IMMUTABLE",
        "EmptyOnDelete": true,
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Expire probe images after one day\", \"selection\": {\"tagStatus\": \"any\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 1}, \"action\": {\"type\": \"expire\"}}]}"
        }
      }
    },
    "RuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "agent-harness-runtime",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock-agentcore.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:runtime/agent_harness_probe_*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ProbeImageAndLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ImagePull",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ProbeRepository",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "ECRAuth",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "AWS::Region"
                      }
                    }
                  }
                },
                {
                  "Sid": "RuntimeLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents",
                    "logs:DescribeLogStreams"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/agent_harness_probe_*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/agent_harness_probe_*:log-stream:*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "DeploymentRole": {
      "Type": "AWS::IAM::Role",
      "DependsOn": "RuntimeIdentityServiceRole",
      "Properties": {
        "RoleName": "agent-harness-deploy",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOIDC"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "${GitHubSubjectPrefix}:ref:refs/heads/main"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "BoundedProbe",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "CreateTaggedRuntime",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:CreateAgentRuntime"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "AWS::Region"
                      },
                      "aws:RequestTag/Project": "agent-harness",
                      "aws:RequestTag/Purpose": "bounded-probe"
                    }
                  }
                },
                {
                  "Sid": "CreateTaggedRuntimeDependencies",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:CreateAgentRuntimeEndpoint",
                    "bedrock-agentcore:TagResource"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:runtime/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "AWS::Region"
                      },
                      "aws:RequestTag/Project": "agent-harness",
                      "aws:RequestTag/Purpose": "bounded-probe"
                    },
                    "ForAllValues:StringEquals": {
                      "aws:TagKeys": [
                        "Project",
                        "Purpose"
                      ]
                    }
                  }
                },
                {
                  "Sid": "CreateTaggedWorkloadIdentity",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:CreateWorkloadIdentity",
                    "bedrock-agentcore:TagResource"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:workload-identity-directory/default/workload-identity/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "AWS::Region"
                      },
                      "aws:RequestTag/Project": "agent-harness",
                      "aws:RequestTag/Purpose": "bounded-probe"
                    },
                    "ForAllValues:StringEquals": {
                      "aws:TagKeys": [
                        "Project",
                        "Purpose"
                      ]
                    }
                  }
                },
                {
                  "Sid": "ProbeRuntime",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetAgentRuntime",
                    "bedrock-agentcore:DeleteAgentRuntime",
                    "bedrock-agentcore:DeleteAgentRuntimeEndpoint",
                    "bedrock-agentcore:InvokeAgentRuntime",
                    "bedrock-agentcore:InvokeAgentRuntimeCommand",
                    "bedrock-agentcore:StopRuntimeSession"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:runtime/agent_harness_probe_*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:runtime/agent_harness_probe_*/runtime-endpoint/*"
                    }
                  ]
                },
                {
                  "Sid": "DeleteProbeIdentity",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:DeleteWorkloadIdentity"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:workload-identity-directory/default/workload-identity/agent_harness_probe_*"
                  }
                },
                {
                  "Sid": "FindAmbiguousCreate",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:ListAgentRuntimes"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "AWS::Region"
                      }
                    }
                  }
                },
                {
                  "Sid": "PassOnlyRuntimeRole",
                  "Effect": "Allow",
                  "Action": [
                    "iam:PassRole"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "RuntimeRole",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
                    }
                  }
                },
                {
                  "Sid": "ECRAuth",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "AWS::Region"
                      }
                    }
                  }
                },
                {
                  "Sid": "ProbeImage",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage",
                    "ecr:DescribeImages",
                    "ecr:ListImages",
                    "ecr:BatchDeleteImage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ProbeRepository",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "FindProbeLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:DescribeLogGroups"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "AWS::Region"
                      }
                    }
                  }
                },
                {
                  "Sid": "CleanProbeLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:PutRetentionPolicy",
                    "logs:DeleteLogGroup"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/agent_harness_probe_*"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "DeploymentRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DeploymentRole",
          "Arn"
        ]
      }
    },
    "RuntimeRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "RuntimeRole",
          "Arn"
        ]
      }
    },
    "RepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "ProbeRepository",
          "RepositoryUri"
        ]
      }
    }
  }
}
